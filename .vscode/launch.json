    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server",
      "runtimeExecutable": "tsx",
      "program": "${workspaceFolder}/src/server/Server.ts",
      "env": {
        "GAME_ENV": "dev"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ],
      "sourceMaps": true,
      "restart": true
    }
  ]
}
